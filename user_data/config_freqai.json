{
  "exchange": { "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT"] },
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 90,
    "backtest_period_days": 7,
    "live_retrain_hours": 0,
    "identifier": "lgbm_fwdret_v1",
    "feature_parameters": {
      "include_timeframes": ["1h", "4h"],
      "include_corr_pairlist": ["BTC/USDT"],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "DI_threshold": 0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [14, 28]
    },
    "data_split_parameters": { "test_size": 0.25, "random_state": 1, "shuffle": false },
    "model_training_parameters": { "n_estimators": 300, "learning_rate": 0.03, "num_leaves": 31, "verbosity": -1 }
  }
}